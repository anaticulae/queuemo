FROM 169.254.149.20:6001/arch_python_git_ghost_opencv_baw:v1.46.0

RUN pip install "queuemo==CURRENT" && pip cache purge

VOLUME /var/shared/
VOLUME /var/cached/

ENV SHARED_TODO=/var/shared/todo
