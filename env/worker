: "${WORKER:=1}"
: "${JOBS:=10240}"
: "${RUNTIME:=1000000}"

echo "WORKER:  ${WORKER}"
echo "RUNTIME: ${RUNTIME}"
echo "JOBS:    ${JOBS}"

for ((NUMBER=0; NUMBER < (${WORKER}-1); NUMBER++)); do
    echo "start: ${NUMBER}"
    queuemo --jobs=${JOBS} --runtime=${RUNTIME} -VV >> ${NUMBER}.log &
    sleep 1
done
echo "start: ${NUMBER}"
echo "see progress in NUMBER.log"
echo "running..."
# wait for completion
queuemo --jobs=${JOBS} --runtime=${RUNTIME} -VV >> ${NUMBER}.log
